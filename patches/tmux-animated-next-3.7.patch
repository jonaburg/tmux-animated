@@ -0,0 +1,250 @@
+name: upstream-check
+
+on:
+  schedule:
+    - cron: '0 6 * * *'
+  workflow_dispatch:
+  push:
+    branches: [master]
+    paths:
+      - 'patches/**'
+      - '.github/workflows/upstream-check.yml'
+
+permissions:
+  contents: write
+  issues: write
+  pull-requests: write
+
+jobs:
+  apply-and-build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Ensure issue labels exist
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          gh label create upstream-drift --force \
+            --color cc7700 \
+            --description "Upstream sync needs manual attention" \
+            -R ${{ github.repository }} || true
+
+      - name: Checkout tmux-animated
+        uses: actions/checkout@v4
+        with:
+          path: tmux-animated
+
+      - name: Install build deps
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            build-essential autoconf automake pkg-config bison \
+            libevent-dev libncurses-dev libutempter-dev
+
+      - name: Clone upstream tmux master
+        run: git clone --depth=1 https://github.com/tmux/tmux.git upstream-tmux
+
+      - name: Record upstream SHA
+        id: upstream
+        run: |
+          cd upstream-tmux
+          echo "sha=$(git rev-parse HEAD)"           >> "$GITHUB_OUTPUT"
+          echo "short=$(git rev-parse --short HEAD)" >> "$GITHUB_OUTPUT"
+
+      - name: Apply patch
+        run: |
+          cd upstream-tmux
+          git apply --index --whitespace=nowarn \
+            ../tmux-animated/patches/tmux-animated-next-3.7.patch
+
+      - name: Build
+        run: |
+          cd upstream-tmux
+          ./autogen.sh
+          ./configure
+          make -j"$(nproc)"
+
+      - name: Smoke test binary
+        run: |
+          cd upstream-tmux
+          ./tmux -V
+
+      - name: Open issue on failure
+        if: failure()
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const title = `upstream-check failed against tmux/tmux@${{ steps.upstream.outputs.short }}`;
+            const body  = [
+              `The scheduled upstream check failed.`,
+              ``,
+              `- Upstream SHA: \`${{ steps.upstream.outputs.sha }}\``,
+              `- Run: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
+              ``,
+              `The patch likely no longer applies cleanly, or the build broke.`,
+            ].join('\n');
+
+            const { data: existing } = await github.rest.issues.listForRepo({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              state: 'open',
+              labels: 'upstream-drift',
+              per_page: 100,
+            });
+            if (existing.some(i => i.title.startsWith('upstream-check failed'))) {
+              core.info('Open upstream-drift issue already exists; skipping.');
+              return;
+            }
+            await github.rest.issues.create({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              title,
+              body,
+              labels: ['upstream-drift'],
+            });
+
+  open-sync-pr:
+    runs-on: ubuntu-latest
+    needs: apply-and-build
+    if: github.event_name == 'schedule' || github.event_name == 'workflow_dispatch'
+    steps:
+      - name: Checkout animations (full history)
+        uses: actions/checkout@v4
+        with:
+          ref: animations
+          fetch-depth: 0
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Install build deps
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            build-essential autoconf automake pkg-config bison \
+            libevent-dev libncurses-dev libutempter-dev
+
+      - name: Add upstream remote and fetch
+        run: |
+          git remote add upstream https://github.com/tmux/tmux.git
+          git fetch upstream master
+          echo "UPSTREAM_SHA=$(git rev-parse upstream/master)"           >> "$GITHUB_ENV"
+          echo "UPSTREAM_SHORT=$(git rev-parse --short upstream/master)" >> "$GITHUB_ENV"
+
+      - name: Bail if already up to date
+        id: check
+        run: |
+          if git merge-base --is-ancestor "$UPSTREAM_SHA" HEAD; then
+            echo "up_to_date=true" >> "$GITHUB_OUTPUT"
+            echo "animations already contains upstream/master ($UPSTREAM_SHORT). Nothing to do."
+          else
+            echo "up_to_date=false" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: Configure bot identity
+        if: steps.check.outputs.up_to_date == 'false'
+        run: |
+          git config user.name  'github-actions[bot]'
+          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+
+      - name: Create sync branch and merge upstream
+        if: steps.check.outputs.up_to_date == 'false'
+        id: merge
+        run: |
+          BRANCH="bot/upstream-sync-${UPSTREAM_SHORT}"
+          echo "branch=$BRANCH" >> "$GITHUB_OUTPUT"
+          git checkout -b "$BRANCH"
+          if ! git merge --no-edit --no-ff upstream/master \
+                -m "Merge upstream tmux/tmux@${UPSTREAM_SHORT} into animations"; then
+            echo "conflict=true" >> "$GITHUB_OUTPUT"
+            git merge --abort || true
+            exit 0
+          fi
+          echo "conflict=false" >> "$GITHUB_OUTPUT"
+
+      - name: Regenerate patch file
+        if: steps.check.outputs.up_to_date == 'false' && steps.merge.outputs.conflict == 'false'
+        run: |
+          git fetch origin master:refs/remotes/origin/master
+          git diff origin/master..HEAD -- ':!patches/' \
+            > patches/tmux-animated-next-3.7.patch
+          if ! git diff --quiet -- patches/; then
+            git add patches/tmux-animated-next-3.7.patch
+            git commit -m "Regenerate patch against upstream@${UPSTREAM_SHORT}"
+          fi
+
+      - name: Build to verify
+        if: steps.check.outputs.up_to_date == 'false' && steps.merge.outputs.conflict == 'false'
+        run: |
+          ./autogen.sh
+          ./configure
+          make -j"$(nproc)"
+          ./tmux -V
+
+      - name: Push branch
+        if: steps.check.outputs.up_to_date == 'false' && steps.merge.outputs.conflict == 'false'
+        run: git push --force-with-lease origin "${{ steps.merge.outputs.branch }}"
+
+      - name: Open or update PR
+        if: steps.check.outputs.up_to_date == 'false' && steps.merge.outputs.conflict == 'false'
+        uses: actions/github-script@v7
+        env:
+          BRANCH: ${{ steps.merge.outputs.branch }}
+        with:
+          script: |
+            const branch = process.env.BRANCH;
+            const short  = process.env.UPSTREAM_SHORT;
+            const title  = `Sync upstream tmux/tmux@${short} into animations`;
+            const body   = [
+              `Automated upstream sync.`,
+              ``,
+              `- Upstream SHA: \`${process.env.UPSTREAM_SHA}\``,
+              `- Patch regenerated against \`origin/master\`.`,
+              `- Build + \`tmux -V\` smoke test passed on \`ubuntu-latest\`.`,
+              ``,
+              `Review the merge and the regenerated patch before merging.`,
+            ].join('\n');
+
+            const { data: open } = await github.rest.pulls.list({
+              owner: context.repo.owner,
+              repo:  context.repo.repo,
+              head:  `${context.repo.owner}:${branch}`,
+              state: 'open',
+            });
+            if (open.length === 0) {
+              await github.rest.pulls.create({
+                owner: context.repo.owner,
+                repo:  context.repo.repo,
+                head:  branch,
+                base:  'animations',
+                title, body,
+              });
+            } else {
+              core.info(`PR #${open[0].number} already open for ${branch}; branch updated in place.`);
+            }
+
+      - name: Open issue on merge conflict
+        if: steps.check.outputs.up_to_date == 'false' && steps.merge.outputs.conflict == 'true'
+        uses: actions/github-script@v7
+        with:
+          script: |
+            const title = `upstream sync: merge conflict against tmux/tmux@${process.env.UPSTREAM_SHORT}`;
+            const body  = [
+              `Tried to merge \`upstream/master\` into \`animations\` and hit conflicts.`,
+              ``,
+              `- Upstream SHA: \`${process.env.UPSTREAM_SHA}\``,
+              `- Run: ${context.serverUrl}/${context.repo.owner}/${context.repo.repo}/actions/runs/${context.runId}`,
+              ``,
+              `Manual merge required.`,
+            ].join('\n');
+            const { data: existing } = await github.rest.issues.listForRepo({
+              owner: context.repo.owner,
+              repo:  context.repo.repo,
+              state: 'open',
+              labels: 'upstream-drift',
+              per_page: 100,
+            });
+            if (existing.some(i => i.title.startsWith('upstream sync: merge conflict'))) return;
+            await github.rest.issues.create({
+              owner: context.repo.owner,
+              repo:  context.repo.repo,
