+		int closing = pd->anim_closing;
+		pd->anim_active = 0;
+		pd->anim_closing = 0;
+		if (closing) {
+			server_client_clear_overlay(pd->c);
+			return;
+		}
+		server_redraw_client(pd->c);
+		return;
+	}
+
+	server_redraw_client(pd->c);
+	tv.tv_sec = 0;
+	tv.tv_usec = 16 * 1000L;
+	evtimer_add(&pd->anim_timer, &tv);
+}
