index 00000000..24b7b519
--- /dev/null
+++ b/.github/workflows/mirror-releases.yml
@@ -0,0 +1,198 @@
+name: mirror-releases
+
+on:
+  schedule:
+    - cron: '30 6 * * *'
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  issues: write
+
+jobs:
+  # Mirror the newest unmirrored upstream release into animations.
+  mirror-release:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout animations (full history + tags)
+        uses: actions/checkout@v4
+        with:
+          ref: animations
+          fetch-depth: 0
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Install build deps
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y --no-install-recommends \
+            build-essential autoconf automake pkg-config bison \
+            libevent-dev libncurses-dev libutempter-dev
+
+      - name: Fetch upstream tags
+        run: |
+          git remote add upstream https://github.com/tmux/tmux.git
+          git fetch upstream --tags --no-tags \
+            'refs/tags/[0-9]*:refs/tags/upstream-[0-9]*' || true
+          git fetch upstream 'refs/tags/*:refs/tags/upstream-*'
+
+      - name: Pick newest unmirrored upstream tag
+        id: pick
+        run: |
+          # All upstream release-shaped tags (e.g. 3.5, 3.5a, 3.6), newest first.
+          mapfile -t up < <(git tag --list 'upstream-[0-9]*' \
+            | sed 's/^upstream-//' \
+            | grep -E '^[0-9]+\.[0-9]+[a-z]?$' \
+            | sort -V -r)
+          for tag in "${up[@]}"; do
+            if ! git rev-parse -q --verify "refs/tags/v${tag}-animated" >/dev/null; then
+              echo "tag=$tag" >> "$GITHUB_OUTPUT"
+              echo "Picked upstream tag: $tag"
+              exit 0
+            fi
+          done
+          echo "All upstream release tags already mirrored."
+          echo "tag=" >> "$GITHUB_OUTPUT"
+
+      - name: Configure bot identity
+        if: steps.pick.outputs.tag != ''
+        run: |
+          git config user.name  'github-actions[bot]'
+          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
+
+      - name: Merge upstream tag into animations
+        if: steps.pick.outputs.tag != ''
+        id: merge
+        run: |
+          TAG="${{ steps.pick.outputs.tag }}"
+          if ! git merge --no-edit --no-ff "upstream-${TAG}" \
+                -m "Merge upstream tmux ${TAG} into animations"; then
+            # configure.ac's AC_INIT version string is the only line that
+            # conflicts on every release. Resolve only hunks where the
+            # sole difference is AC_INIT, taking upstream's value. Leave
+            # other hunks marked so they fall through to the issue path.
+            if git diff --name-only --diff-filter=U | grep -qx configure.ac; then
+              UPSTREAM_AC_INIT=$(git show "upstream-${TAG}:configure.ac" \
+                | grep -E '^AC_INIT\(' | head -1)
+              if [ -n "$UPSTREAM_AC_INIT" ]; then
+                python3 - "$UPSTREAM_AC_INIT" <<'PY'
+import sys, pathlib
+upstream = sys.argv[1].rstrip('\n') + '\n'
+p = pathlib.Path('configure.ac')
+src = p.read_text().splitlines(keepends=True)
+out, i = [], 0
+while i < len(src):
+    line = src[i]
+    if not line.startswith('<<<<<<<'):
+        out.append(line); i += 1
+        continue
+    ours, theirs = [], []
+    i += 1
+    while i < len(src) and not src[i].startswith('======='):
+        ours.append(src[i]); i += 1
+    i += 1
+    while i < len(src) and not src[i].startswith('>>>>>>>'):
+        theirs.append(src[i]); i += 1
+    i += 1
+    ours_no = [l for l in ours if not l.startswith('AC_INIT(')]
+    theirs_no = [l for l in theirs if not l.startswith('AC_INIT(')]
+    if ours_no == theirs_no:
+        out.extend(upstream if l.startswith('AC_INIT(') else l for l in ours)
+    else:
+        out.append(line)
+        out.extend(ours)
+        out.append('=======\n')
+        out.extend(theirs)
+        out.append('>>>>>>> theirs\n')
+p.write_text(''.join(out))
+PY
+                if ! grep -qE '^(<<<<<<<|=======|>>>>>>>)' configure.ac; then
+                  git add configure.ac
+                fi
+              fi
+            fi
+            REMAINING=$(git diff --name-only --diff-filter=U)
+            if [ -z "$REMAINING" ]; then
+              git commit --no-edit
+              echo "conflict=false" >> "$GITHUB_OUTPUT"
+              exit 0
+            fi
+            FILES=$(printf '%s' "$REMAINING" | head -50)
+            STATUS=$(git status --short | head -50)
+            {
+              echo "files<<__EOF__"
+              echo "$FILES"
+              echo "__EOF__"
+              echo "status<<__EOF__"
+              echo "$STATUS"
+              echo "__EOF__"
+            } >> "$GITHUB_OUTPUT"
+            git merge --abort || true
+            echo "conflict=true" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          echo "conflict=false" >> "$GITHUB_OUTPUT"
+
+      - name: Regenerate patch
+        if: steps.pick.outputs.tag != '' && steps.merge.outputs.conflict == 'false'
+        run: |
+          git fetch origin master:refs/remotes/origin/master
+          git diff origin/master..HEAD -- ':!patches/' \
+            > patches/tmux-animated-next-3.7.patch
+          if ! git diff --quiet -- patches/; then
+            git add patches/tmux-animated-next-3.7.patch
+            git commit -m "Regenerate patch for tmux ${{ steps.pick.outputs.tag }}"
+          fi
+
+      - name: Build to verify
+        if: steps.pick.outputs.tag != '' && steps.merge.outputs.conflict == 'false'
+        run: |
+          ./autogen.sh
+          ./configure
+          make -j"$(nproc)"
+          ./tmux -V
+
+      - name: Push to animations and tag release
+        if: steps.pick.outputs.tag != '' && steps.merge.outputs.conflict == 'false'
+        env:
+          TAG: ${{ steps.pick.outputs.tag }}
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          REL="v${TAG}-animated"
+          if git rev-parse -q --verify "refs/tags/${REL}" >/dev/null; then
+            echo "Tag ${REL} already exists; nothing to push."
+            exit 0
+          fi
+          # Fast-forward animations to the just-merged HEAD, then tag.
+          git push origin "HEAD:refs/heads/animations"
+          git tag -a "${REL}" -m "tmux-animated for tmux ${TAG}"
+          git push origin "${REL}"
+
+      - name: Ensure issue labels exist
+        if: steps.pick.outputs.tag != '' && steps.merge.outputs.conflict == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          gh label create upstream-drift --force \
+            --color cc7700 \
+            --description "Upstream sync needs manual attention" || true
+
+      - name: Open issue on merge conflict
+        if: steps.pick.outputs.tag != '' && steps.merge.outputs.conflict == 'true'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          TAG: ${{ steps.pick.outputs.tag }}
+          FILES: ${{ steps.merge.outputs.files }}
+          STATUS: ${{ steps.merge.outputs.status }}
+        run: |
+          {
+            printf 'Could not merge upstream tag `%s` into `animations`. Manual merge required.\n\n' "$TAG"
+            printf 'Run: %s/%s/actions/runs/%s\n\n' \
+              "${{ github.server_url }}" "${{ github.repository }}" "${{ github.run_id }}"
+            printf '## Conflicting files\n\n```\n%s\n```\n\n' "$FILES"
+            printf '## git status\n\n```\n%s\n```\n\n' "$STATUS"
+            printf '## Reproduce locally\n\n```sh\ngit fetch upstream --tags\ngit checkout animations\ngit merge --no-edit --no-ff upstream-%s\n```\n' "$TAG"
+          } > /tmp/issue-body.md
+          gh api -X POST "/repos/${{ github.repository }}/issues" \
+            -f "title=Release sync conflict: tmux ${TAG}" \
+            -f "body=$(cat /tmp/issue-body.md)" \
+            -f "labels[]=upstream-drift"
